{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-framework.invalid/schema/2/roadmap.schema.json",
  "title": "Delivery Roadmap schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "title",
    "repositories",
    "milestoneOrder"
  ],
  "properties": {
    "kind": {
      "const": "delivery-roadmap"
    },
    "schemaVersion": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity"],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestoneOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M-[0-9]{3,}$"
      }
    }
  }
}
