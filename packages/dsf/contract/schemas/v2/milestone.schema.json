{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-framework.invalid/schema/2/milestone.schema.json",
  "title": "Delivery Milestone schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "title",
    "objective",
    "governingDesignReferences",
    "dependsOn",
    "acceptanceCriteria",
    "verification",
    "completionEvidence"
  ],
  "properties": {
    "kind": {
      "const": "delivery-milestone"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^M-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M-[0-9]{3,}$"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "requirement"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2,}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "covers", "requirement"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^VR-[0-9]{2,}$"
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{2,}$"
            }
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completionEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "requirement"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2,}$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governingDesignReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
