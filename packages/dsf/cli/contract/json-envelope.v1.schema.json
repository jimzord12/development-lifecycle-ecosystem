{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-envelope.v1.schema.json",
  "title": "DLE CLI JSON envelope V1",
  "description": "Universal result envelope for --json invocations. No envelope schemaVersion exists in V1.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "result", "warnings"],
      "properties": {
        "ok": { "const": true },
        "command": { "type": "string", "minLength": 1 },
        "result": { "type": "object" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "command", "error", "warnings"],
      "properties": {
        "ok": { "const": false },
        "command": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/error" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    }
  ],
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
