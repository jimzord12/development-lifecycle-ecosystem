{
  "name": "development-lifecycle-ecosystem",
  "version": "0.0.0",
  "private": true,
  "description": "Public, framework-generic home of the Development Lifecycle Ecosystem (DLE) and its independently versioned lifecycle components.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "proposals:index": "node scripts/proposals.mjs --write",
    "proposals:check": "node scripts/proposals.mjs --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:proposals": "node --test scripts/proposals.test.mjs",
    "test": "pnpm test:proposals && pnpm -r --if-present run test",
    "test:coverage": "pnpm test:proposals && pnpm -r --if-present run test:coverage",
    "build": "pnpm -r --if-present run build",
    "validate": "pnpm proposals:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
